# ==========================================================
# HookRelay 环境变量模板
# 用法：复制为 .env 后填入真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 排除，绝不要提交到仓库
# ==========================================================

# ---------- 基础 ----------
# 运行环境：dev | prod
ENV=dev
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 是否输出 JSON 结构化日志。本地开发建议 false（看得清楚），
# 部署到平台后设为 true，日志系统可以直接按字段检索
LOG_JSON=false

# 对称加密密钥，用于加密存储 endpoint 的签名密钥
# 生成方式：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# ---------- 数据库 ----------
# 本地开发（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://localhost:5432/hookrelay_dev
# 测试库
TEST_DATABASE_URL=postgresql+asyncpg://localhost:5432/hookrelay_test

# ---------- Worker 投递引擎 ----------
# 并发投递数（云端 512MB 内存建议调低到 5 左右）
WORKER_CONCURRENCY=10
# 每轮从队列取的任务数
WORKER_BATCH_SIZE=50
# 队列为空时的休眠间隔（秒），避免空转打满 CPU
WORKER_POLL_INTERVAL_SECONDS=1.0
# 任务卡在 delivering 状态超过该秒数视为僵尸任务，回滚为 pending
WORKER_LOCK_TIMEOUT_SECONDS=120
# Worker 自身的指标端口。投递指标在 Worker 进程里，
# 不在 Web 服务的 /metrics 里，需要通过这个端口单独抓取
WORKER_METRICS_PORT=9101

# ---------- 入站接收 ----------
# 每个 endpoint 每分钟允许的事件数
INGEST_RATE_LIMIT_PER_MINUTE=120
# 请求体大小上限（字节），默认 1MB
MAX_INGEST_BODY_BYTES=1048576
# 签名时间戳容差窗口（秒），超出判定为过期请求
SIGNATURE_TOLERANCE_SECONDS=300

# ---------- 默认投递策略 ----------
# 默认最大尝试次数
DEFAULT_MAX_ATTEMPTS=5
# 默认单次投递超时（秒）
DEFAULT_TIMEOUT_SECONDS=10
# 退避基数（秒），实际延迟 = base * factor^(attempt-1)
RETRY_BASE_DELAY_SECONDS=2
# 退避延迟上限（秒）
RETRY_MAX_DELAY_SECONDS=3600
# 抖动比例（0.2 表示 ±20%），避免大量任务同时重试
RETRY_JITTER_RATIO=0.2
